# Railway -> service -> Variables. Never commit real values.
# Names match your liftbuddy service so the two bots stay consistent.
DISCORD_TOKEN=          # Discord dev portal -> LarpBuddy -> Bot -> Reset Token
CHANNEL_ID=             # right-click target channel -> Copy Channel ID
GUILD_ID=               # right-click the LeetBuddy server -> Copy Server ID
GITHUB_REPO=notjackl3/intern-radar
GITHUB_BRANCH=main
POLL_SECONDS=300
DATA_DIR=/data          # liftbuddy's DB_PATH equivalent; needs a volume at /data
